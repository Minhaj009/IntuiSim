# IntuiSim Environment Configuration Template
# Copy this file to .env and adjust as necessary for your environment.

# Base project path override (defaults to the repository root if unset)
# INTUISIM_ROOT=/path/to/IntuiSim

# Headless Chromium executable path (optional, defaults to system Chrome / Puppeteer)
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# Whisper Compute Device ('cuda' or 'cpu')
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# NVENC hardware acceleration ('cuda' or 'cpu' fallback)
FFMPEG_HWACCEL=cuda
